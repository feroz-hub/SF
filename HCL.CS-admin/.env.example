# Copy to .env.local and replace placeholders with Installer-generated values.
NEXTAUTH_URL=https://localhost:3001
NEXTAUTH_SECRET=<generate-a-random-32-byte-or-longer-value>

HCL_CS_ISSUER=https://localhost:5180
HCL_CS_CLIENT_ID=<installer-generated-admin-client-id>
HCL_CS_CLIENT_SECRET=<installer-generated-admin-client-secret>
HCL_CS_API_BASE_URL=https://localhost:5180
HCL_CS_DEMO_SERVER_BASE_URL=https://localhost:5180

HCL_CS_SCOPES=openid profile email offline_access phone hcl-cs.apiresource hcl-cs.client hcl-cs.user hcl-cs.role hcl-cs.identityresource hcl-cs.adminuser hcl-cs.securitytoken
HCL_CS_METADATA_ADDRESS=https://localhost:5180/.well-known/openid-configuration
HCL_CS_TOKEN_ENDPOINT=https://localhost:5180/security/token
HCL_CS_REVOCATION_ENDPOINT=https://localhost:5180/security/revocation
HCL_CS_POST_LOGOUT_REDIRECT_URI=https://localhost:3001/login
HCL_CS_ENABLE_FEDERATED_LOGOUT=false

# Windows start script supplies NODE_EXTRA_CA_CERTS for the trusted development certificate.
HCL_CS_ALLOW_INSECURE_TLS=false
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
