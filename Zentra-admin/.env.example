# Public URL where this Next.js app is reachable
NEXTAUTH_URL=https://admin.localhost:3001

# Random secret for NextAuth JWT/session encryption
NEXTAUTH_SECRET=X7w7bXF3g4vIK8nTwCKaNkMga0TDyqEREkzmcavNHBs=

# Zentra identity issuer base URL
ZENTRA_ISSUER=https://localhost:5001

# OAuth client credentials configured in Zentra for this admin app
ZENTRA_CLIENT_ID=REDbgSB6J3jb3N9uolHJH74HzZDKM0wrcxZYf+Xve+I=
ZENTRA_CLIENT_SECRET=8pS9klVkqg3ntTN+dEp9biqEdc9OlHAajB3mM9EiLPM=

# Zentra API base URL used for /Security/Api/* calls
ZENTRA_API_BASE_URL=https://localhost:5001

# Demo Server base URL (health check + Google sign-in). Must be the URL where Zentra.Demo.Server runs.
# If you run only the Identity API on 5001, run the Demo Server separately (e.g. on 5002) and set this:
# ZENTRA_DEMO_SERVER_BASE_URL=https://localhost:5002
ZENTRA_DEMO_SERVER_BASE_URL=https://localhost:5001

# Space-separated scopes requested at login
ZENTRA_SCOPES=openid profile email offline_access phone zentra.apiresource zentra.client zentra.user zentra.role zentra.identityresource zentra.adminuser zentra.securitytoken

# Optional explicit endpoints (fallback to OIDC discovery if omitted)
ZENTRA_METADATA_ADDRESS=https://localhost:5001/.well-known/openid-configuration
ZENTRA_TOKEN_ENDPOINT=https://localhost:5001/security/token
ZENTRA_REVOCATION_ENDPOINT=https://localhost:5001/security/revocation

# Where Zentra should return user after end-session
ZENTRA_POST_LOGOUT_REDIRECT_URI=https://admin.localhost:3001/login

# Set true only when Zentra /security/endsession is fully configured and stable.
# Keep false to use local app logout only.
ZENTRA_ENABLE_FEDERATED_LOGOUT=false

# Development-only self-signed cert bypass. Keep false in production.
ZENTRA_ALLOW_INSECURE_TLS=true

# Set true to show "Sign in with Google" on the login page. Requires Demo Server Google config
# (Authentication:Google:Enabled, ClientId, ClientSecret) and admin client with user_code grant type.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true
