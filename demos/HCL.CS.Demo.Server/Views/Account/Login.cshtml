@model HCL.CS.DemoServerApp.Models.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "hcltech-login-body";
}

<div class="hcltech-login-page">
    <section class="hcltech-login-story" aria-labelledby="brand-message">
        <div class="hcltech-login-story__glow hcltech-login-story__glow--one" aria-hidden="true"></div>
        <div class="hcltech-login-story__glow hcltech-login-story__glow--two" aria-hidden="true"></div>
        <div class="hcltech-login-story__grid" aria-hidden="true"></div>

        <div class="hcltech-login-story__content">
            <a class="hcltech-wordmark hcltech-wordmark--light"
               asp-area="" asp-controller="Home" asp-action="Index"
               aria-label="HCLTech home">HCLTech</a>

            <div class="hcltech-login-story__message">
                <span class="hcltech-product-label">HCL.CS Identity</span>
                <h1 id="brand-message">Secure access.<br /><span>Supercharged.</span></h1>
                <p>One trusted identity experience for the applications, teams, and ideas that keep progress moving.</p>

                <div class="hcltech-trust-points" aria-label="Security features">
                    <div class="hcltech-trust-point">
                        <span class="hcltech-trust-point__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.5-2.9 8.1-7 10-4.1-1.9-7-5.5-7-10V6l7-3z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                            </svg>
                        </span>
                        <span><strong>Protected</strong> enterprise identity</span>
                    </div>
                    <div class="hcltech-trust-point">
                        <span class="hcltech-trust-point__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path stroke-linecap="round" d="M8 10V7a4 4 0 018 0v3" />
                            </svg>
                        </span>
                        <span><strong>Encrypted</strong> secure sessions</span>
                    </div>
                </div>
            </div>

            <p class="hcltech-login-story__footer">HCL.CS &nbsp;·&nbsp; An HCLTech product</p>
        </div>
    </section>

    <section class="hcltech-login-panel" aria-label="Sign in">
        <div class="hcltech-login-panel__inner">
            <a class="hcltech-wordmark hcltech-wordmark--mobile"
               asp-area="" asp-controller="Home" asp-action="Index"
               aria-label="HCLTech home">HCLTech</a>

            <div class="hcltech-login-heading">
                <span class="hcltech-login-heading__eyebrow">HCL.CS Identity</span>
                <h2>Welcome back</h2>
                <p>Sign in to continue to your secure workspace.</p>
            </div>

            @if (TempData["ExternalAuthError"] != null)
            {
                <div class="hcltech-alert" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <path stroke-linecap="round" d="M12 8v5m0 3h.01" />
                    </svg>
                    <span>@TempData["ExternalAuthError"]</span>
                </div>
            }

            <form class="hcltech-login-form"
                  asp-action="Login" asp-controller="Account"
                  asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="All" class="hcltech-validation-summary"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="hcltech-field">
                    <label asp-for="UserName">Email or username</label>
                    <div class="hcltech-field__control">
                        <span class="hcltech-field__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="12" cy="8" r="3.5" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.5 20a6.5 6.5 0 0113 0" />
                            </svg>
                        </span>
                        <input asp-for="UserName" class="form-control" placeholder="Enter your email or username"
                               autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="UserName" class="hcltech-field__error"></span>
                </div>

                <div class="hcltech-field">
                    <div class="hcltech-field__label-row">
                        <label asp-for="Password">Password</label>
                        <a asp-controller="Account" asp-action="ForgetPassword"
                           asp-route-returnurl="@ViewData["ReturnUrl"]">Forgot password?</a>
                    </div>
                    <div class="hcltech-field__control">
                        <span class="hcltech-field__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path stroke-linecap="round" d="M8 10V7a4 4 0 018 0v3" />
                            </svg>
                        </span>
                        <input asp-for="Password" class="form-control hcltech-password-input"
                               placeholder="Enter your password" autocomplete="current-password" />
                        <button type="button" class="hcltech-password-toggle" data-password-toggle
                                aria-label="Show password" aria-controls="Password" aria-pressed="false">
                            <span class="hcltech-password-toggle__show" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z" />
                                    <circle cx="12" cy="12" r="2.5" />
                                </svg>
                            </span>
                            <span class="hcltech-password-toggle__hide" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path stroke-linecap="round" d="M3 3l18 18" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.6 6.1A10 10 0 0112 6c6 0 9.5 6 9.5 6a15.5 15.5 0 01-2.3 3M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a9.8 9.8 0 004.1-.9" />
                                </svg>
                            </span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="hcltech-field__error"></span>
                </div>

                <button type="submit" class="hcltech-primary-button" name="button" value="login">
                    <span>Sign in</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-5-5l5 5-5 5" />
                    </svg>
                </button>
            </form>

            <div class="hcltech-divider"><span>or</span></div>

            <form method="get" action="/auth/external/google/start">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <input type="hidden" name="tenantId" value="@Context.Request.Query["tenantId"]" />
                <button class="hcltech-google-button" type="submit">
                    <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                        <path fill="#FBBC05" d="M5.84 14.09A6.2 6.2 0 015.49 12c0-.73.13-1.43.35-2.09V7.07H2.18A11 11 0 001 12c0 1.78.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z" />
                    </svg>
                    <span>Continue with Google</span>
                </button>
            </form>

            <div class="hcltech-session-note">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.5-2.9 8.1-7 10-4.1-1.9-7-5.5-7-10V6l7-3z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                </svg>
                <span>Your connection is encrypted and securely protected.</span>
            </div>

            <p class="hcltech-login-panel__footer">&copy; @DateTime.UtcNow.Year HCLTech. All rights reserved.</p>
        </div>
    </section>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var input = document.getElementById("Password");
            var toggle = document.querySelector("[data-password-toggle]");
            if (!input || !toggle) {
                return;
            }

            toggle.addEventListener("click", function () {
                var showPassword = input.type === "password";
                input.type = showPassword ? "text" : "password";
                toggle.setAttribute("aria-pressed", String(showPassword));
                toggle.setAttribute("aria-label", showPassword ? "Hide password" : "Show password");
            });
        });
    </script>
}
