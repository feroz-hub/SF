@model HCL.CS.DemoServerApp.Models.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}

<style>
    /* ---- Futuristic secure login theme ---- */
    .login-page {
        min-height: calc(100vh - 180px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        position: relative;
        overflow: hidden;
        background: #05070d;
        background-image:
            linear-gradient(rgba(6, 182, 212, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(6, 182, 212, 0.03) 1px, transparent 1px);
        background-size: 48px 48px;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        width: 100vw;
        box-sizing: border-box;
        overflow-x: hidden;
    }
    @@keyframes gridPulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 0.7; }
    }
    .login-page::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(6, 182, 212, 0.08) 0%, transparent 60%);
        pointer-events: none;
    }
    .login-page::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 120px;
        background: linear-gradient(to top, #05070d, transparent);
        pointer-events: none;
    }

    .login-card {
        width: 100%;
        max-width: 440px;
        position: relative;
        z-index: 2;
        background: rgba(15, 23, 42, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(6, 182, 212, 0.25);
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.04) inset,
            0 32px 64px -24px rgba(0, 0, 0, 0.6),
            0 0 80px -20px rgba(6, 182, 212, 0.15);
        overflow: hidden;
        animation: cardIn 0.6s ease-out;
    }
    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-card__header {
        padding: 2.25rem 2rem 1.5rem;
        text-align: center;
        border-bottom: 1px solid rgba(6, 182, 212, 0.12);
        position: relative;
    }
    .login-card__header::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(6, 182, 212, 0.5), transparent);
        border-radius: 2px;
    }

    .login-card__secure-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 1rem;
        background: rgba(6, 182, 212, 0.12);
        border: 1px solid rgba(6, 182, 212, 0.35);
        color: #67e8f9;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border-radius: 9999px;
        margin-bottom: 1.25rem;
        box-shadow: 0 0 24px rgba(6, 182, 212, 0.15);
        animation: securePulse 2.5s ease-in-out infinite;
    }
    @@keyframes securePulse {
        0%, 100% { box-shadow: 0 0 24px rgba(6, 182, 212, 0.15); border-color: rgba(6, 182, 212, 0.35); }
        50% { box-shadow: 0 0 32px rgba(6, 182, 212, 0.25); border-color: rgba(6, 182, 212, 0.5); }
    }
    .login-card__secure-badge svg {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        animation: lockPulse 2s ease-in-out infinite;
    }
    @@keyframes lockPulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }

    .login-card__title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #f8fafc;
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
    }
    .login-card__subtitle {
        font-size: 0.9375rem;
        color: rgba(148, 163, 184, 0.95);
        margin: 0;
        line-height: 1.5;
        max-width: 320px;
        margin-left: auto;
        margin-right: auto;
    }
    .login-card__subtitle strong {
        color: rgba(103, 232, 249, 0.95);
        font-weight: 600;
    }

    .login-card__body {
        padding: 1.75rem 2rem 2rem;
    }
    .login-card .form-group {
        margin-bottom: 1.35rem;
    }
    .login-card label {
        font-size: 0.8125rem;
        font-weight: 600;
        color: rgba(203, 213, 225, 0.95);
        margin-bottom: 0.5rem;
        display: block;
        letter-spacing: 0.02em;
    }
    .login-card .form-control {
        height: 3rem;
        border-radius: 12px;
        border: 1px solid rgba(71, 85, 105, 0.8);
        background: rgba(15, 23, 42, 0.6);
        color: #f1f5f9;
        padding: 0 1rem;
        font-size: 0.9375rem;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .login-card .form-control::placeholder {
        color: rgba(148, 163, 184, 0.5);
    }
    .login-card .form-control:focus {
        border-color: rgba(6, 182, 212, 0.6);
        background: rgba(15, 23, 42, 0.8);
        box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.2);
        outline: none;
    }
    .login-password-field {
        position: relative;
        display: flex;
        align-items: center;
    }
    .login-password-input {
        padding-right: 3.5rem;
    }
    .login-password-toggle {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        width: 2rem;
        height: 2rem;
        border: none;
        border-radius: 9999px;
        background: transparent;
        color: rgba(148, 163, 184, 0.9);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, box-shadow 0.2s;
    }
    .login-password-toggle:hover {
        background: rgba(51, 65, 85, 0.45);
        color: #f8fafc;
    }
    .login-password-toggle:focus-visible {
        outline: none;
        box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.2);
    }
    .login-password-toggle svg {
        width: 18px;
        height: 18px;
    }
    .login-password-toggle__icon--hide {
        display: none;
    }
    .login-password-toggle[aria-pressed="true"] .login-password-toggle__icon--show {
        display: none;
    }
    .login-password-toggle[aria-pressed="true"] .login-password-toggle__icon--hide {
        display: inline-flex;
    }
    .login-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    .login-card .btn-primary {
        width: 100%;
        height: 3rem;
        font-weight: 700;
        font-size: 0.9375rem;
        letter-spacing: 0.04em;
        border-radius: 12px;
        background: linear-gradient(135deg, #0891b2 0%, #06b6d4 50%, #22d3ee 100%);
        border: none;
        color: #0c0f1a;
        transition: transform 0.2s, box-shadow 0.2s, filter 0.2s;
    }
    .login-card .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px -8px rgba(6, 182, 212, 0.5);
        filter: brightness(1.08);
    }
    .login-card .btn-outline-dark {
        width: 100%;
        height: 3rem;
        font-weight: 600;
        font-size: 0.875rem;
        border-radius: 12px;
        border: 1px solid rgba(71, 85, 105, 0.8);
        background: rgba(30, 41, 59, 0.5);
        color: #e2e8f0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
    }
    .login-card .btn-outline-dark:hover {
        background: rgba(51, 65, 85, 0.6);
        border-color: rgba(148, 163, 184, 0.5);
        color: #f8fafc;
    }
    .login-divider {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 1.5rem 0;
        color: rgba(100, 116, 139, 0.9);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }
    .login-divider::before,
    .login-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(71, 85, 105, 0.6), transparent);
    }
    .login-card .text-danger {
        font-size: 0.8125rem;
        margin-top: 0.35rem;
        color: #f87171;
    }
    .login-card .alert-danger {
        border-radius: 12px;
        font-size: 0.875rem;
        background: rgba(248, 113, 113, 0.1);
        border: 1px solid rgba(248, 113, 113, 0.3);
        color: #fca5a5;
    }
    .login-forgot {
        text-align: center;
        margin-top: 1rem;
    }
    .login-forgot a {
        font-size: 0.875rem;
        font-weight: 500;
        color: #67e8f9;
        text-decoration: none;
        transition: color 0.2s, text-shadow 0.2s;
    }
    .login-forgot a:hover {
        color: #22d3ee;
        text-shadow: 0 0 20px rgba(103, 232, 249, 0.4);
    }

    .login-trust {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(71, 85, 105, 0.3);
        font-size: 0.6875rem;
        color: rgba(148, 163, 184, 0.7);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .login-trust svg {
        width: 12px;
        height: 12px;
        color: rgba(34, 197, 94, 0.8);
        flex-shrink: 0;
    }
</style>

<div class="login-page">
    <div class="login-card">
        <div class="login-card__header">
            <div class="login-card__secure-badge" aria-label="Secure session">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                Secure session
            </div>
            <h1 class="login-card__title">Welcome back</h1>
            <p class="login-card__subtitle">Your connection is <strong>encrypted</strong>. Sign in to access your secure workspace. Every session is protected end-to-end.</p>
        </div>

        <div class="login-card__body">
            @if (TempData["ExternalAuthError"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["ExternalAuthError"]</div>
            }

            <form asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="form-group">
                    <label asp-for="UserName">Email or username</label>
                    <input asp-for="UserName" class="form-control" placeholder="Enter your username" autocomplete="username" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <div class="login-password-field">
                        <input asp-for="Password" class="form-control login-password-input" placeholder="Enter your password" autocomplete="current-password" />
                        <button type="button"
                                class="login-password-toggle"
                                data-password-toggle
                                aria-label="Show password"
                                aria-controls="Password"
                                aria-pressed="false">
                            <span class="login-password-toggle__icon--show" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7zm9.542 3a3 3 0 100-6 3 3 0 000 6z" />
                                </svg>
                            </span>
                            <span class="login-password-toggle__icon--hide" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M10.584 10.587a2 2 0 002.828 2.828M9.88 5.09A10.94 10.94 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.523 10.523 0 01-4.043 5.252M6.228 6.228A10.45 10.45 0 002.458 12c1.274 4.057 5.064 7 9.542 7a10.94 10.94 0 005.09-1.228" />
                                </svg>
                            </span>
                            <span class="login-sr-only">Toggle password visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary" name="button" value="login">Sign in securely</button>
                </div>
                <div class="login-forgot">
                    <a asp-controller="Account" asp-action="ForgetPassword" asp-route-returnurl="@ViewData["ReturnUrl"]">Forgot password?</a>
                </div>
            </form>

            <div class="login-divider">or continue with</div>

            <form method="get" action="/auth/external/google/start">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <input type="hidden" name="tenantId" value="@Context.Request.Query["tenantId"]" />
                <button class="btn btn-outline-dark" type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    Continue with Google
                </button>
            </form>

            <div class="login-trust">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                Protected connection · HCL.CS · This is a HCLTech Product.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var input = document.getElementById("Password");
            var toggle = document.querySelector("[data-password-toggle]");
            if (!input || !toggle) {
                return;
            }

            toggle.addEventListener("click", function () {
                var showPassword = input.type === "password";
                input.type = showPassword ? "text" : "password";
                toggle.setAttribute("aria-pressed", String(showPassword));
                toggle.setAttribute("aria-label", showPassword ? "Hide password" : "Show password");
            });
        });
    </script>
}
